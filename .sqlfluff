# dbt lint（dbt v2 に組み込みのリンター）の設定。書式は SQLFluff と同じ。
# dbt Labs の jaffle-shop の設定（https://github.com/dbt-labs/jaffle-shop/blob/main/.sqlfluff）をもとにしている。
[sqlfluff]
templater = dbt
dialect = duckdb
runaway_limit = 10
max_line_length = 120
indent_unit = space
# 外すルール
# - capitalisation.identifiers: staging では元データの列名（gameId などのキャメルケース）を
#   そのまま書いて snake_case に付け替えるため
# - structure.column_order: キー・シーズン・試合の種類の順に、意味のまとまりで列を並べたいため
#   （シーズンなどはマクロで求める列なので、このルールでは後ろに回すことになる）
exclude_rules = capitalisation.identifiers, structure.column_order

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit
